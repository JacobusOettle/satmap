{
  "about": "Shared examples for TestBuildSwitch (SatMap/Core/TestBuildSwitch.swift and android/core/.../TestBuildSwitch.kt); both cores' tests read this file. files: a status file ('file' as JSON, written out compactly, or 'text' as it is) and what parse gives (null: no information). links: allowedLink. decisions: known(saved, fetched) and lock(...) on each platform, for statuses already checked. channels: Channel(setting), and checks(channel) for a build that isn't a debug build. requestUrls: requestURL(base, now).",
  "defaults": {
    "title": "This test version of SatMap has been switched off",
    "message": "Get SatMap from the App Store or Google Play to keep using it.",
    "maxTitleLength": 120,
    "maxMessageLength": 500,
    "maxFileBytes": 65536,
    "checkIntervalSeconds": 300,
    "timeoutSeconds": 10,
    "savedKey": "testBuildStatus",
    "userAgent": {
      "version": "1.0",
      "value": "SatMap/1.0"
    }
  },
