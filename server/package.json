{
  "name": "satmap-groups-server",
  "version": "1.0.0",
  "private": true,
  "description": "SatMap groups: Cloudflare Worker and Durable Objects (docs/groups/SPEC.md)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run --project unit --project integration",
    "test:ws": "vitest run --project ws --max-workers=1 --no-isolate",
    "typecheck": "tsc --noEmit",
    "build": "wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev",
    "types": "wrangler types --strict-vars=false"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.4",
    "typescript": "6.0.3",
    "vitest": "4.1.12",
    "wrangler": "4.151.1"
  },
  "overrides": {
    "undici": "7.30.1",
    "zod": "4.6.7"
  }
}
